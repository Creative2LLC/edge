{
  "definitions": [
    {
      "title": "Card Row Compact",
      "id": "card-row-compact",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Card Row Compact",
              "model": "card-row-compact",
              "filter": "card-row-compact"
            }
          }
        }
      }
    },
    {
      "title": "Card Row Compact Item",
      "id": "card-row-compact-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card Row Compact Item",
              "model": "card-row-compact-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card-row-compact",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "columns",
          "label": "Cards Per Row",
          "description": "Number of cards per row (default: 4)",
          "options": [
            {
              "name": "Default (4)",
              "value": ""
            },
            {
              "name": "1 Card",
              "value": "1"
            },
            {
              "name": "2 Cards",
              "value": "2"
            },
            {
              "name": "3 Cards",
              "value": "3"
            },
            {
              "name": "4 Cards",
              "value": "4"
            },
            {
              "name": "5 Cards",
              "value": "5"
            },
            {
              "name": "6 Cards",
              "value": "6"
            }
          ],
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "alignment",
          "label": "Content Alignment",
          "description": "Alignment for all card content (icon, title, subheading, link)",
          "options": [
            {
              "name": "Left",
              "value": "left"
            },
            {
              "name": "Center",
              "value": "center"
            },
            {
              "name": "Right",
              "value": "right"
            }
          ],
          "value": "left"
        }
      ]
    },
    {
      "id": "card-row-compact-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "icon",
          "label": "Icon",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconColor",
          "label": "Icon Color (Hex)",
          "description": "Color applied to the icon via CSS mask. Leave empty to show original image."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "subheading",
          "label": "Subheading"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "titleColor",
          "label": "Title Text Color (Hex)",
          "description": "Defaults to #404041 if left empty"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "subheadingColor",
          "label": "Subheading Text Color (Hex)",
          "description": "Defaults to #404041 if left empty"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkText",
          "label": "Link Text"
        },
        {
          "component": "aem-content",
          "name": "linkUrl",
          "label": "Link URL"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkColor",
          "label": "Link Text Color (Hex)",
          "description": "Defaults to #007294 if left empty"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardBackgroundColor",
          "label": "Card Background Color (Hex)",
          "description": "Defaults to white (#ffffff) if left empty"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "card-row-compact",
      "components": [
        "card-row-compact-item"
      ]
    }
  ]
