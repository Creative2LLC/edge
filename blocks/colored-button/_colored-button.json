{
  "definitions": [
    {
      "title": "Colored Button",
      "id": "colored-button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Colored Button",
              "model": "colored-button"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "colored-button",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Button Text",
          "value": "Learn More"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link"
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "backgroundColor",
          "label": "Background Color (Hex)",
          "value": "#008DB6",
          "validation": {
            "regExp": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #008DB6."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "textColor",
          "label": "Text Color (Hex)",
          "value": "#FFFFFF",
          "validation": {
            "regExp": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #FFFFFF."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "borderColor",
          "label": "Border Color (Hex, Optional)",
          "description": "Leave empty to match the background color.",
          "value": "",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #008DB6."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "blockBackgroundColor",
          "label": "Block Background Color (Hex, Optional)",
          "description": "Leave empty for a transparent block background.",
          "value": "",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #F4F1EC."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "appearance",
          "label": "Appearance",
          "options": [
            { "name": "Solid", "value": "solid" },
            { "name": "Outlined", "value": "outlined" },
            { "name": "Inverted", "value": "inverted" }
          ],
          "value": "solid"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "invertOnHover",
          "label": "Invert On Hover",
          "options": [
            { "name": "No", "value": "no" },
            { "name": "Yes", "value": "yes" }
          ],
          "value": "no"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "horizontalAlign",
          "label": "Horizontal Alignment",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Center", "value": "center" },
            { "name": "Right", "value": "right" },
            { "name": "Stretch", "value": "stretch" }
          ],
          "value": "left"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "verticalAlign",
          "label": "Vertical Alignment",
          "options": [
            { "name": "Top", "value": "top" },
            { "name": "Middle", "value": "middle" },
            { "name": "Bottom", "value": "bottom" }
          ],
          "value": "top"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "fontSize",
          "label": "Font Size",
          "description": "Optional CSS length such as 16px, 1rem, or clamp(1rem, 2vw, 1.25rem).",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "fontWeight",
          "label": "Font Weight",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Regular", "value": "400" },
            { "name": "Medium", "value": "500" },
            { "name": "Semi Bold", "value": "600" },
            { "name": "Bold", "value": "700" },
            { "name": "Extra Bold", "value": "800" }
          ],
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "icon",
          "label": "Icon Image (Optional)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconName",
          "label": "Icon Name (Optional)",
          "description": "Optional fallback icon name from /icons, for example search or download.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconAlt",
          "label": "Icon Alt Text",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "iconPosition",
          "label": "Icon Position",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Right", "value": "right" },
            { "name": "None", "value": "none" }
          ],
          "value": "left"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconSize",
          "label": "Icon Size",
          "description": "Optional CSS length. Defaults to 1em.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "minHeight",
          "label": "Minimum Height",
          "description": "Optional CSS length. Use this when vertical alignment needs a taller area.",
          "value": ""
        }
      ]
    }
  ],
  "filters": []
}
