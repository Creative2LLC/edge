        {
          "component": "text",
          "valueType": "string",
          "name": "fontSize",
          "label": "Font Size",
          "description": "Optional CSS length such as 48px, 3rem, or clamp(2rem, 5vw, 4rem).",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "fontWeight",
          "label": "Font Weight",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Regular", "value": "400" },
            { "name": "Medium", "value": "500" },
            { "name": "Semi Bold", "value": "600" },
            { "name": "Bold", "value": "700" },
            { "name": "Extra Bold", "value": "800" }
          ],
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "minHeight",
          "label": "Minimum Height",
          "description": "Optional CSS length. Use this when vertical alignment needs a taller area.",
