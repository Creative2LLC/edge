            { "name": "H1", "value": "h1" },
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" },
            { "name": "H5", "value": "h5" },
            { "name": "H6", "value": "h6" }
          ],
          "value": "h2"
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "textColor",
          "label": "Text Color (Hex)",
          "description": "Enter a hex color, for example #00264D.",
          "value": "#00264D",
          "validation": {
            "regExp": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #00264D."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "blockBackgroundColor",
          "label": "Block Background Color (Hex, Optional)",
          "description": "Leave empty for a transparent block background.",
          "value": "",
