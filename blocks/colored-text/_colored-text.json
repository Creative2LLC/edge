{
  "definitions": [
    {
      "title": "Colored Text",
      "id": "colored-text",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Colored Text",
              "model": "colored-text"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "colored-text",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text"
        },
        {
          "component": "text",
          "valueType": "string",
          "valueFormat": "regexp",
          "name": "textColor",
          "label": "Text Color (Hex)",
          "description": "Enter a hex color, for example #00264D.",
          "value": "#404041",
          "validation": {
            "regExp": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #00264D."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "horizontalAlign",
          "label": "Horizontal Alignment",
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Center", "value": "center" },
            { "name": "Right", "value": "right" },
            { "name": "Justify", "value": "justify" }
          ],
          "value": "left"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "verticalAlign",
          "label": "Vertical Alignment",
          "options": [
            { "name": "Top", "value": "top" },
            { "name": "Middle", "value": "middle" },
            { "name": "Bottom", "value": "bottom" }
          ],
          "value": "top"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "fontSize",
          "label": "Font Size",
          "description": "Optional CSS length such as 20px, 1.5rem, or clamp(1.25rem, 3vw, 2rem).",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "fontWeight",
          "label": "Font Weight",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Regular", "value": "400" },
            { "name": "Medium", "value": "500" },
            { "name": "Semi Bold", "value": "600" },
            { "name": "Bold", "value": "700" },
            { "name": "Extra Bold", "value": "800" }
          ],
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "minHeight",
          "label": "Minimum Height",
          "description": "Optional CSS length. Use this when vertical alignment needs a taller area.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "minHeightMobile",
          "label": "Minimum Height (Mobile)",
          "description": "Optional CSS length override for screens ≤ 640px. Leave blank to use the same value as Minimum Height.",
          "value": ""
        }
      ]
    }
  ],
  "filters": []
