{
  "definitions": [
    {
      "title": "CyberTipline Geo Report",
      "id": "cybertipline-geo-report",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "CyberTipline Geo Report",
              "model": "cybertipline-geo-report",
              "filter": "cybertipline-geo-report"
            }
          }
        }
      }
    },
    {
      "title": "CyberTipline Geo Report Row",
      "id": "cybertipline-geo-report-row",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "CyberTipline Geo Report Row",
              "model": "cybertipline-geo-report-row"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "cybertipline-geo-report",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "value": "CyberTipline Reports by Geography"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "intro",
          "label": "Intro Copy",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "apiBaseUrl",
          "label": "API Base URL",
          "description": "Laravel backend base URL. The block fetches /api/cybertipline-reports/{year}/datasets/{datasetSlug}."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "year",
          "label": "Report Year",
          "description": "Leave blank to use /api/cybertipline-reports/current."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "datasetSlug",
          "label": "Dataset Slug",
          "value": "domestic-state-reports"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "geoType",
          "label": "Geography Type",
          "options": [
            {
              "name": "State",
              "value": "state"
            },
            {
              "name": "Country / Global",
              "value": "country"
            },
            {
              "name": "Auto",
              "value": "auto"
            }
          ],
          "value": "state"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "emptyMessage",
          "label": "Empty State Message",
          "value": "No CyberTipline geography data is available."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sampleDataMode",
          "label": "Sample Data Mode",
          "description": "For testing only. Use Off for real CyberTipline API data.",
          "options": [
            {
              "name": "Off",
              "value": "off"
            },
            {
              "name": "Use When Empty",
              "value": "when-empty"
            },
            {
              "name": "Always Use Sample",
              "value": "always"
            }
          ],
          "value": "off"
        }
      ]
    },
    {
      "id": "cybertipline-geo-report-row",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Location Name"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "code",
          "label": "State/Country Code"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "value",
          "label": "Report Count"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "Detail Text"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "color",
          "label": "Map Color (Optional Hex)"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cybertipline-geo-report",
      "components": [
        "cybertipline-geo-report-row"
      ]
    }
  ]
