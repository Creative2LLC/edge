  "models": [
    {
      "id": "cybertipline-geo-report",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "value": "CyberTipline Reports by Geography"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "intro",
          "label": "Intro Copy",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "apiBaseUrl",
          "label": "API Base URL",
          "description": "Laravel backend base URL. The block fetches /api/cybertipline-reports/{year}/datasets/{datasetSlug}."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "year",
          "label": "Report Year",
          "description": "Leave blank to use /api/cybertipline-reports/current."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "datasetSlug",
          "label": "Dataset Slug",
          "value": "domestic-state-reports"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "geoType",
          "label": "Geography Type",
          "options": [
            {
              "name": "State",
              "value": "state"
            },
            {
              "name": "Country / Global",
              "value": "country"
            },
            {
              "name": "Auto",
              "value": "auto"
            }
          ],
          "value": "state"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "emptyMessage",
          "label": "Empty State Message",
          "value": "No CyberTipline geography data is available."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sampleDataMode",
          "label": "Sample Data Mode",
          "description": "For testing only. Use Off for real CyberTipline API data.",
          "options": [
            {
              "name": "Off",
              "value": "off"
            },
            {
              "name": "Use When Empty",
              "value": "when-empty"
            },
            {
              "name": "Always Use Sample",
              "value": "always"
            }
          ],
          "value": "off"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "textMode",
          "label": "Text Mode",
          "description": "Light mode uses white heading/body text. Dark mode uses the default colors.",
          "options": [
            {
              "name": "Dark (default)",
              "value": "dark"
            },
            {
              "name": "Light",
              "value": "light"
            }
          ],
          "value": "dark"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "disclaimerText",
          "label": "Disclaimer Text",
          "description": "Optional text displayed under the map/list area.",
          "value": ""
        }
      ]
    },
