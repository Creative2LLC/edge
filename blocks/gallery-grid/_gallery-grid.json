{
  "definitions": [
    {
      "title": "Gallery Grid",
      "id": "gallery-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Gallery Grid",
              "model": "gallery-grid",
              "filter": "gallery-grid"
            }
          }
        }
      }
    },
    {
      "title": "Gallery Grid Item",
      "id": "gallery-grid-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Gallery Grid Item",
              "model": "gallery-grid-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "gallery-grid",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "columns",
          "label": "Columns",
          "description": "Number of equal-size columns on desktop.",
          "options": [
            { "name": "2 Columns", "value": "2" },
            { "name": "3 Columns", "value": "3" },
            { "name": "4 Columns", "value": "4" }
          ],
          "value": "2"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "gap",
          "label": "Gap",
          "description": "Optional CSS length between grid items. Defaults to 24px.",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "borderRadius",
          "label": "Item Border Radius",
          "options": [
            { "name": "None (default)", "value": "none" },
            { "name": "Small", "value": "small" },
            { "name": "Medium", "value": "medium" },
            { "name": "Large", "value": "large" }
          ],
          "value": "none"
        }
      ]
    },
    {
      "id": "gallery-grid-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image (Optional)",
          "description": "Fills this grid slot edge-to-edge. Add Statistics or Cards directly to the Gallery Grid as separate grid items.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text Content (Optional)",
          "description": "For a plain text card instead of an image. Ignored if a Background Image is set.",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "backgroundColor",
          "label": "Text Card Background Color",
          "options": [
            { "name": "Default / None", "value": "" },
            { "name": "White (#FFFFFF)", "value": "#FFFFFF" },
            { "name": "Navy Dark (#00264D)", "value": "#00264D" },
            { "name": "Navy Medium (#004B76)", "value": "#004B76" },
            { "name": "Blue Dark (#006D90)", "value": "#006D90" },
            { "name": "Blue Medium (#008EB7)", "value": "#008EB7" },
            { "name": "Blue Light (#92D6E3)", "value": "#92D6E3" },
            { "name": "Gray Dark (#414042)", "value": "#414042" },
            { "name": "Gray Medium (#939598)", "value": "#939598" },
            { "name": "Gray Light (#C7C8CA)", "value": "#C7C8CA" },
            { "name": "Gray Lightest (#F1F2F2)", "value": "#F1F2F2" },
            { "name": "Warm Off-White (#F4F1EC)", "value": "#F4F1EC" },
            { "name": "Warm Gray (#ECE8E3)", "value": "#ECE8E3" },
            { "name": "Blue Tint (#E9F7FA)", "value": "#E9F7FA" },
            { "name": "Yellow (#FDB913)", "value": "#FDB913" },
            { "name": "Yellow Dark (#F7941D)", "value": "#F7941D" },
            { "name": "Red, urgent only (#AE1B1F)", "value": "#AE1B1F" },
            { "name": "Peach Dark (#F26D5F)", "value": "#F26D5F" },
            { "name": "Peach Medium (#F8AC99)", "value": "#F8AC99" },
            { "name": "Beige Dark (#FAAB60)", "value": "#FAAB60" },
            { "name": "Beige Medium (#FDCFA3)", "value": "#FDCFA3" },
            { "name": "Green Medium (#5ABB64)", "value": "#5ABB64" },
            { "name": "Green Light (#A2D4A3)", "value": "#A2D4A3" }
          ],
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #007294."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "textColor",
          "label": "Text Card Text Color",
          "options": [
            { "name": "Default / None", "value": "" },
            { "name": "White (#FFFFFF)", "value": "#FFFFFF" },
            { "name": "Navy Dark (#00264D)", "value": "#00264D" },
            { "name": "Navy Medium (#004B76)", "value": "#004B76" },
            { "name": "Blue Dark (#006D90)", "value": "#006D90" },
            { "name": "Gray Dark (#414042)", "value": "#414042" },
            { "name": "Gray Lightest (#F1F2F2)", "value": "#F1F2F2" },
            { "name": "Red, urgent only (#AE1B1F)", "value": "#AE1B1F" }
          ],
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #FFFFFF."
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "gallery-grid",
      "components": [
        "gallery-grid-item",
        "statistics",
        "cards"
      ]
    }
  ]
}
