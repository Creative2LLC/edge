{
  "definitions": [
    {
      "title": "Gallery Grid",
      "id": "gallery-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Gallery Grid",
              "model": "gallery-grid",
              "filter": "gallery-grid"
            }
          }
        }
      }
    },
    {
      "title": "Gallery Grid Item",
      "id": "gallery-grid-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Gallery Grid Item",
              "model": "gallery-grid-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "gallery-grid",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "columns",
          "label": "Columns",
          "description": "Number of equal-size columns on desktop.",
          "options": [
            { "name": "2 Columns", "value": "2" },
            { "name": "3 Columns", "value": "3" },
            { "name": "4 Columns", "value": "4" }
          ],
          "value": "2"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "gap",
          "label": "Gap",
          "description": "Optional CSS length between grid items. Defaults to 24px.",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "borderRadius",
          "label": "Item Border Radius",
          "options": [
            { "name": "None (default)", "value": "none" },
            { "name": "Small", "value": "small" },
            { "name": "Medium", "value": "medium" },
            { "name": "Large", "value": "large" }
          ],
          "value": "none"
        }
      ]
    },
    {
      "id": "gallery-grid-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image (Optional)",
          "description": "Fills this grid slot edge-to-edge. Add Statistics or Cards directly to the Gallery Grid as separate grid items.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text Content (Optional)",
          "description": "For a plain text card instead of an image. Ignored if a Background Image is set.",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "backgroundColor",
          "label": "Text Card Background Color",
          "options": [
            { "name": "Default / None", "value": "" },
            { "name": "White (#FFFFFF)", "value": "#FFFFFF" },
            { "name": "Primary Blue 1 (#00264D)", "value": "#00264D" },
            { "name": "Primary Blue 2 (#007294)", "value": "#007294" },
            { "name": "Primary Blue 3 (#008EB7)", "value": "#008EB7" },
            { "name": "Brand Blue (#008DB6)", "value": "#008DB6" },
            { "name": "Primary Grey 1 (#404041)", "value": "#404041" },
            { "name": "Primary Grey 2 (#0D273B)", "value": "#0D273B" },
            { "name": "Primary Grey 3 (#A1A1A1)", "value": "#A1A1A1" },
            { "name": "Orange (#E07E27)", "value": "#E07E27" },
            { "name": "Peach (#FCBC7E)", "value": "#FCBC7E" },
            { "name": "Green (#7BC581)", "value": "#7BC581" },
            { "name": "Primary Red 1 (#E13E30)", "value": "#E13E30" },
            { "name": "Primary Red 2 (#F58A80)", "value": "#F58A80" },
            { "name": "Light Blue (#92D6E3)", "value": "#92D6E3" },
            { "name": "Light Grey 1 (#F6F6F6)", "value": "#F6F6F6" },
            { "name": "Light Grey 2 (#E7E4E1)", "value": "#E7E4E1" },
            { "name": "Light Grey 3 (#DDD5CC)", "value": "#DDD5CC" },
            { "name": "Light Yellow (#FECF5D)", "value": "#FECF5D" }
          ],
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #007294."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "textColor",
          "label": "Text Card Text Color",
          "options": [
            { "name": "Default / None", "value": "" },
            { "name": "White (#FFFFFF)", "value": "#FFFFFF" },
            { "name": "Primary Blue 1 (#00264D)", "value": "#00264D" },
            { "name": "Primary Blue 2 (#007294)", "value": "#007294" },
            { "name": "Primary Blue 3 (#008EB7)", "value": "#008EB7" },
            { "name": "Brand Blue (#008DB6)", "value": "#008DB6" },
            { "name": "Primary Grey 1 (#404041)", "value": "#404041" },
            { "name": "Primary Grey 2 (#0D273B)", "value": "#0D273B" },
            { "name": "Primary Grey 3 (#A1A1A1)", "value": "#A1A1A1" },
            { "name": "Orange (#E07E27)", "value": "#E07E27" },
            { "name": "Peach (#FCBC7E)", "value": "#FCBC7E" },
            { "name": "Green (#7BC581)", "value": "#7BC581" },
            { "name": "Primary Red 1 (#E13E30)", "value": "#E13E30" },
            { "name": "Primary Red 2 (#F58A80)", "value": "#F58A80" },
            { "name": "Light Blue (#92D6E3)", "value": "#92D6E3" },
            { "name": "Light Grey 1 (#F6F6F6)", "value": "#F6F6F6" },
            { "name": "Light Grey 2 (#E7E4E1)", "value": "#E7E4E1" },
            { "name": "Light Grey 3 (#DDD5CC)", "value": "#DDD5CC" },
            { "name": "Light Yellow (#FECF5D)", "value": "#FECF5D" }
          ],
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^$|^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
            "customErrorMsg": "Enter a valid hex color, for example #FFFFFF."
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "gallery-grid",
      "components": [
        "gallery-grid-item",
        "statistics",
        "cards"
      ]
    }
  ]
}
