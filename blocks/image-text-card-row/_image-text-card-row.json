          "name": "title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "subtitle",
          "label": "Subtitle"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "bodyText",
          "label": "Body Text"
        },
        {
          "component": "text",
