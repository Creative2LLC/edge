              "name": "Image Text Card Row Item",
              "model": "image-text-card-row-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "image-text-card-row",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "columns",
          "label": "Cards Per Row",
          "description": "Number of cards to display per row (defaults to 3)",
          "options": [
            {
              "name": "1 Card",
              "value": "1"
            },
            {
              "name": "2 Cards",
              "value": "2"
            },
            {
              "name": "3 Cards",
              "value": "3"
            }
          ],
          "value": "3"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "imageStyle",
          "label": "Image Style",
          "description": "Default = full-width image at the top of the card. Small = 141x183 image positioned at the top-left of the card with padding around it.",
          "options": [
            {
              "name": "Default (Full Width Top)",
              "value": "default"
            },
            {
              "name": "Small (141x183 Top Left)",
              "value": "small"
            }
          ],
          "value": "default"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "imageAlign",
          "label": "Image Alignment",
          "description": "Controls which part of the image is shown when cropped (object-position). Center is the default.",
          "options": [
            {
              "name": "Center",
              "value": "center"
            },
            {
              "name": "Left",
              "value": "left"
            },
            {
              "name": "Right",
              "value": "right"
            }
          ],
          "value": "center"
        }
      ]
    },
    {
      "id": "image-text-card-row-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Card Image",
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "icon",
          "label": "Icon (Optional)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconColor",
          "label": "Icon Color (Hex)"
        },
        {
          "component": "text",
