      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Impact Bar Chart",
              "model": "impact-bar-chart",
              "filter": "impact-bar-chart"
            }
          }
        }
      }
    },
    {
      "title": "Impact Bar Chart Row",
      "id": "impact-bar-chart-row",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Impact Bar Chart Row",
              "model": "impact-bar-chart-row"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "impact-bar-chart",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "intro",
          "label": "Intro Text",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "apiBaseUrl",
          "label": "API Base URL",
          "description": "Laravel backend base URL. The block fetches /api/impact-reports/{year}/datasets/{datasetSlug}.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "year",
          "label": "Report Year",
          "description": "Leave blank to request the current impact report when API Base URL is set.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "datasetSlug",
          "label": "Dataset Slug",
          "description": "Example: reports-by-type or offender-relationship.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "apiEndpoint",
          "label": "API Endpoint URL",
          "description": "Optional override for custom JSON. Leave blank to use API Base URL + Report Year + Dataset Slug.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "valueKey",
          "label": "Value Key",
          "description": "Defaults to value. Use another key when charting a value from Additional Values or API row data.",
          "value": "value"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "metricKeys",
          "label": "Stacked Metrics",
          "description": "Optional. One per line as Label|key|#color. Use for stacked/grouped data like Images|images|#1491BF.",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "chartStyle",
          "label": "Chart Style",
          "options": [
            {
              "name": "Standard",
              "value": ""
            },
            {
              "name": "Skinny",
              "value": "skinny"
            }
          ],
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "showValues",
          "label": "Show Values",
          "options": [
            {
              "name": "Show",
              "value": "show"
            },
            {
              "name": "Hide",
              "value": "hide"
            }
          ],
          "value": "show"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "showTable",
          "label": "Data Table Display",
          "description": "For multi-series charts, Toggle provides the chart/list behavior used by the legacy report.",
          "options": [
            {
              "name": "Chart only",
              "value": "hide"
            },
            {
              "name": "Chart and table",
              "value": "show"
            },
            {
              "name": "Chart / table toggle",
              "value": "toggle"
            },
            {
              "name": "Table only",
              "value": "table"
            }
          ],
          "value": "hide"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "emptyMessage",
          "label": "Empty State Message",
          "value": "No impact chart data is available."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "textMode",
          "label": "Text Mode",
          "description": "Light mode uses white heading/body text. Dark mode uses the default colors.",
          "options": [
            {
              "name": "Dark (default)",
              "value": "dark"
            },
            {
              "name": "Light",
              "value": "light"
            }
          ],
          "value": "dark"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "disclaimer",
          "label": "Disclaimer Text (Optional)",
          "description": "Optional fine print shown below the chart/table.",
          "value": ""
        }
      ]
    },
    {
