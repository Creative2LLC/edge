{
  "definitions": [
    {
      "title": "Resource Downloads",
      "id": "resource-downloads",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Resource Downloads",
              "model": "resource-downloads",
              "filter": "resource-downloads"
            }
          }
        }
      }
    },
    {
      "title": "Download Item",
      "id": "resource-download-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Download Item",
              "model": "resource-download-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "resource-downloads",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "apiBaseUrl",
          "label": "API Base URL",
          "description": "Backend API origin. Filled automatically when the page is generated from a resource."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "slug",
          "label": "Primary Resource Slug",
          "description": "Slug of the resource this landing page belongs to. Filled automatically."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "gated",
          "label": "Gate Downloads (require registration)",
          "description": "Controls the whole page's downloads unless an item overrides it. Synced with the backend resource.",
          "options": [
            {
              "name": "Inherit from resource",
              "value": ""
            },
            {
              "name": "Gated (registration required)",
              "value": "true"
            },
            {
              "name": "Open (no registration)",
              "value": "false"
            }
          ],
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "layout",
          "label": "Layout",
          "options": [
            {
              "name": "Stacked list",
              "value": ""
            },
            {
              "name": "Grid",
              "value": "grid"
            }
          ],
          "value": ""
        }
      ]
    },
    {
      "id": "resource-download-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "itemTitle",
          "label": "Title",
          "description": "Display title for this download. Falls back to the resource title or file name."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "itemDescription",
          "label": "Description",
          "description": "Supporting copy. On Feature cards this doubles as the 'what's inside' line."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "buttonLabel",
          "label": "Button Label",
          "description": "Defaults by file type (Download PDF, Download PowerPoint, Watch Video...)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "resourceSlug",
          "label": "Resource Slug",
          "description": "Link this item to a backend resource by slug (preferred — pulls title, file, thumbnail, and gating from the API)."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "file",
          "label": "File",
          "description": "Direct DAM file link. Only used when no Resource Slug is set."
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image / Poster",
          "description": "Thumbnail for Document cards or poster for Video items. Slug-backed items fall back to the resource thumbnail.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "videoUrl",
          "label": "Video URL",
          "description": "YouTube, Vimeo, or MP4 URL for Video items. Slug-backed items fall back to the resource's video."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "displayStyle",
          "label": "Display Style",
          "description": "Auto picks by file type: video links get the player, ppt/zip the Feature card, documents the card or row.",
          "options": [
            {
              "name": "Auto (by file type)",
              "value": ""
            },
            {
              "name": "Compact row",
              "value": "row"
            },
            {
              "name": "Document card",
              "value": "card"
            },
            {
              "name": "Feature CTA",
              "value": "feature"
            },
            {
              "name": "Video player",
              "value": "video"
            },
            {
              "name": "Grouped buttons (merge with neighbors)",
              "value": "grouped"
            }
          ],
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "gated",
          "label": "Gating Override",
          "options": [
            {
              "name": "Inherit",
              "value": ""
            },
            {
              "name": "Gated (registration required)",
              "value": "gated"
            },
            {
              "name": "Open (no registration)",
              "value": "open"
            }
          ],
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "resource-downloads",
      "components": [
        "resource-download-item"
      ]
    }
  ]
}
