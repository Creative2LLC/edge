[
  {
    "id": "main",
    "components": [
      "section"
    ]
  },
  {
    "id": "richtext",
    "rte": {
      "toolbar": {
        "format": [
          "bold",
          "italic",
          "underline",
          "strike"
        ],
        "blocks": [
          "paragraph",
          "h2",
          "h3",
          "h4"
        ],
        "list": [
          "bullet_list",
          "ordered_list"
        ],
        "insert": [
          "link",
          "unlink",
          "image",
          "special_characters"
        ],
        "editor": [
          "removeformat",
          "paste_text"
        ],
        "sections": [
          "blocks",
          "format",
          "list",
          "insert",
          "editor"
        ]
      },
      "actions": {
        "image": {
          "wrapInPicture": false,
          "shortcut": "Mod-Shift-I",
          "label": "Insert Image"
        },
        "link": {
          "hideTarget": false
        }
      }
    },
    "components": [
      "richtext"
    ]
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
