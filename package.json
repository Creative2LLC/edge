{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/fonts.css\" \"styles/styles.css\" \"styles/lazy-styles.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "build:json": "npm-run-all -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"models/_component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"models/_component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"models/_component-filters.json\" -o \"component-filters.json\"",
    "build:s3-options": "node scripts/build-s3-options.mjs",
    "mock:forms": "node scripts/mock-form-server.mjs",
    "build:pagelist": "node scripts/build-page-list.mjs",
    "audit:blocks": "node scripts/block-inventory.mjs",
    "audit:responsive": "node scripts/responsive-screenshots.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "audit:accessibility": "node scripts/accessibility-audit.mjs",
    "audit:contrast": "node scripts/accessibility-contrast-report.mjs",
    "audit:manual-review": "node scripts/accessibility-manual-review-report.mjs",
    "audit:summarize": "node scripts/audit-summarize.mjs",
    "gallery": "node scripts/build-review-gallery.mjs",
    "spacing-audit": "node scripts/spacing-audit.mjs",
    "gutter-audit": "node scripts/gutter-audit.mjs",
    "inner-padding-audit": "node scripts/inner-padding-audit.mjs",
    "dev:css": "vite build --watch",
    "build:css": "vite build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.5",
    "axe-core": "4.12.1",
    "@playwright/test": "1.62.1",
    "autoprefixer": "10.4.21",
    "baseline-browser-mapping": "^2.10.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-xwalk": "github:adobe-rnd/eslint-plugin-xwalk",
    "husky": "9.1.1",
    "lighthouse": "^12.8.2",
    "merge-json-cli": "1.0.4",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.25",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "tailwindcss": "3.4.17",
    "vite": "5.4.21"
  }
}
